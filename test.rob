let void aret () {
    setSpeed(150 in mm)
    var number count = 0
    loop count < 5
    {
        count = count + 1
        square()
    }
}

let void square(){
    Forward 30 in cm
    Clock 90
    Forward 300 in mm
    Clock 90
    Forward 30 in cm
    Clock 90
    Forward 300 in mm
    Clock 90
    var number a = True
}

let void entry () {
    setSpeed(200 mm) // distance per second (here 200mm/s)
    var number time = getTimestamp()
    loop time < 60000
    {
        var cm dist = getDistance()
        Forward dist - 25 in cm
        Clock 90
        time = getTimestamp()
        var number a = 5 + dist * time / 3
    }
}